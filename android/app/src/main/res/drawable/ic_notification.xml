<?xml version="1.0" encoding="utf-8"?>
<!--
  通知栏小图标。

  Android 从 5.0 起会把通知小图标**当成遮罩**处理：只保留 alpha 通道，
  颜色由系统统一涂。所以这里必须是纯白 + 透明的单色图形 —— 直接拿
  `ic_launcher.png` 那个彩色应用图标，在通知栏里会变成一坨白色方块。

  `flutter_local_notifications` 只按 `getIdentifier(name, "drawable", ...)`
  查找，所以这个文件必须落在 `res/drawable/` 下、名字与
  `NotificationService._androidIcon` 一致，不能放 `mipmap-*`。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 信封：折角 + 两条斜线 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M20,4H4C2.9,4 2.01,4.9 2.01,6L2,18c0,1.1 0.89,2 1.99,2H20c1.1,0 2,-0.9 2,-2V6C22,4.9 21.1,4 20,4zM20,8l-8,5L4,8V6l8,5l8,-5V8z" />
</vector>
