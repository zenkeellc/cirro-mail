<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 重启后排期不丢：插件靠这条权限注册 ScheduledNotificationBootReceiver。
         少了它，用户重启一次手机，所有「稍后提醒」就全没了。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- 精确闹钟。**选 USE_EXACT_ALARM 而不是 SCHEDULE_EXACT_ALARM**：
         前者是应用自己声明、**不需要运行时申请**；后者要弹一个跳系统设置的
         权限框，而这个功能对时间精度的要求只是「差不多那时候」。
         如实记一笔：Play 有权质询一个邮件客户端为什么需要精确闹钟。
         如果被卡，退路是把 Dart 侧的 androidScheduleMode 降成
         inexactAllowWhileIdle —— 晚几分钟弹，权限一个字都不用改。 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <!-- 应用图标数字角标（见 AppIconBadge.kt）。原生 Android 没有公开角标
         API，只能各家 launcher 的私有协议挨个试。下面三条都是 launcher/厂商
         侧声明的 normal 级权限，安装即授予、不弹运行时授权框；没有它们只会让
         对应厂商的角标静默不显示，不影响别家：
         - com.huawei.android.launcher.permission.CHANGE_BADGE：华为/荣耀老
           协议的广播（AppIconBadge.kt 里的 HUAWEI_ACTION）需要它才能被
           launcher 接收（来源：ShortcutBadger 的 AndroidManifest.xml，那一份
           还带 READ_SETTINGS/WRITE_SETTINGS，是给华为 provider 路径用的，本
           实现没走 provider，所以只声明这一条）。
         - PROVIDER_INSERT_BADGE：索尼新机型的角标走
           com.sonymobile.home.resourceprovider 的 badge 表 insert，该 provider
           只接受持有这条权限的应用（来源：ShortcutBadger 的 SonyHomeBadger）。
         - BROADCAST_BADGE：老 Xperia 的
           com.sonyericsson.home.action.UPDATE_BADGE 广播需要它（来源：
           ShortcutBadger 的 AndroidManifest.xml）。
         小米走 ContentProvider、vivo 走广播，两条都不需要额外权限；三星新
         One UI 走私有 provider，本实现没做（见 AppIconBadge.kt 文件头）。 -->
    <uses-permission android:name="com.huawei.android.launcher.permission.CHANGE_BADGE"/>
    <uses-permission android:name="com.sonymobile.home.permission.PROVIDER_INSERT_BADGE"/>
    <uses-permission android:name="com.sonyericsson.home.permission.BROADCAST_BADGE"/>
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- 收到排期时弹出通知。 -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"/>
        <!-- 重启 / 应用更新之后把排期重建起来 —— 配 RECEIVE_BOOT_COMPLETED。 -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
